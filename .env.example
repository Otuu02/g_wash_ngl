# ============================================================
# G-WASH NG — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is listed in .gitignore.
#
# For Flutter builds, inject keys via --dart-define:
#   flutter build appbundle --release \
#     --dart-define=PAYSTACK_PUBLIC_KEY=pk_live_... \
#     --dart-define=PAYSTACK_SECRET_KEY=sk_live_... \
#     --dart-define=GOOGLE_MAPS_API_KEY=AIzaSy... \
#     --dart-define=CLOUDINARY_CLOUD_NAME=... \
#     --dart-define=CLOUDINARY_API_KEY=... \
#     --dart-define=CLOUDINARY_API_SECRET=... \
#     --dart-define=TWILIO_ACCOUNT_SID=AC... \
#     --dart-define=TWILIO_AUTH_TOKEN=... \
#     --dart-define=TWILIO_PHONE_NUMBER=+234... \
#     --dart-define=GMAIL_USER=... \
#     --dart-define=GMAIL_APP_PASSWORD=...
#
# For Android Google Maps key, set the env variable:
#   MAPS_API_KEY=AIzaSy...
# ============================================================

# ── Paystack Payment Gateway ──────────────────────────────
# Get from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_PUBLIC_KEY=pk_live_YOUR_PUBLIC_KEY_HERE
PAYSTACK_SECRET_KEY=sk_live_YOUR_SECRET_KEY_HERE

# ── Google Maps Platform ──────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Maps SDK for Android, Maps SDK for iOS, Places API
GOOGLE_MAPS_API_KEY=AIzaSy_YOUR_MAPS_KEY_HERE
MAPS_API_KEY=AIzaSy_YOUR_ANDROID_MAPS_KEY_HERE

# ── Cloudinary Image Uploads ──────────────────────────────
# Get from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Twilio SMS Notifications ──────────────────────────────
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+234xxxxxxxxxx

# ── Gmail SMTP (for welcome & status emails) ───────────────
# Use a Gmail App Password (NOT your real Gmail password)
# Get from: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
