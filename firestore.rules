rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User documents
    match /users/{userId} {
      // 🔒 Each user can read their OWN profile, admins can read all, and authenticated users can read provider profiles for matching.
      allow read: if isAuthenticated() && (
        isOwner(userId) || 
        isAdmin() || 
        (
          (!resource.data.keys().hasAny(['role']) || resource.data.role != 'customer') &&
          (
            (resource.data.keys().hasAny(['role']) && resource.data.role in ['washer', 'provider', 'cleaner', 'laundry_provider', 'driver', 'service_provider']) ||
            (resource.data.keys().hasAny(['userRole']) && resource.data.userRole in ['washer', 'provider', 'cleaner', 'laundry_provider', 'driver', 'service_provider'])
          )
        )
      );
      // Allow user creation, but restrict updates to prevent changing 'role' to admin
      allow create: if isOwner(userId) && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'customer');
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Washer / Service Provider profiles
    match /washers/{washerId} {
      // 🔒 Washer profile is public-readable for matching (customer needs to see provider info).
      // Only the washer or admin can write.
      allow read: if isAuthenticated();
      allow write: if isOwner(washerId) || isAdmin();
    }

    // Jobs collection
    match /jobs/{jobId} {
      // 🔒 Customer, assigned provider, admin, OR any authenticated provider looking for 'searching'/unassigned jobs can read.
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.washerId == request.auth.uid ||
        resource.data.status == 'searching' ||
        resource.data.washerId == '' ||
        isAdmin()
      );
      // Any authenticated user can create a job (they become the customerId)
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      // Allow update if customer, assigned provider, or admin.
      // 🔒 SECURITY: 'searching' job updates restricted to washer/provider roles only.
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.washerId == request.auth.uid || 
        (
          (resource.data.status == 'searching' || resource.data.washerId == '') &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in 
            ['washer', 'cleaner', 'laundry_provider', 'driver', 'service_provider']
        ) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Transactions collection
    match /transactions/{txnId} {
      // 🔒 Only the transaction owner or admin can read transaction records.
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // System Logs collections (Email & SMS logging)
    // 🔒 SECURITY: Only the owner or admin can read their communication logs.
    match /email_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /sms_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}

